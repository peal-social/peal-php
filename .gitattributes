# What Composer's downloads of the PHP SDK leave out: files only the Peal
# repository needs (Nx's project, Fern's records, the smoke test) and the
# tests and tool settings of the library's own development.
/project.json export-ignore
/.fern export-ignore
/.fernignore export-ignore
/.github export-ignore
/smoke.php export-ignore
/tests export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
