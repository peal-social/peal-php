{
    "name": "peal-social/peal",
    "description": "Schedule posts across social platforms, follow how they did, and manage a Peal workspace's channels, media and members.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://peal.social",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Peal",
            "homepage": "https://peal.social"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3 || ^8.0",
        "guzzlehttp/psr7": "^1.7 || ^2.0 || ^3.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "Peal\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "Peal\\Test\\" : "test/" }
    }
}
